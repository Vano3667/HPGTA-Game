static func t(key: String) -> String:
    var row = S.get(key)
    if row == null:
        return key
    if lang == "ru":
        return row[1]
    return row[0]


static func has(key: String) -> bool:
    return S.has(key)


static func system_lang() -> String:
    if OS.get_locale_language() == "ru":
        return "ru"
    return "en"
